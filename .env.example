# Production environment variables (copy to .env on the server)

# Required — set strong unique values before go-live
ADMIN_PASSWORD=
ADMIN_SECRET=

# Recommended — separate secret for press preview sessions
PRESS_PREVIEW_SECRET=

# Canonical site URL for sitemap, Open Graph, and canonical links
NEXT_PUBLIC_SITE_URL=https://reakton.de

# Local preview only — Clip:Clap:Club desktop 3D robot scene (do not enable on live server yet)
# NEXT_PUBLIC_CLUB_ROBOT_PREVIEW=true
